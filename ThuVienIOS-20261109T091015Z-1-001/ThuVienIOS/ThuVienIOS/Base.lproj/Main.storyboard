    <scenes>
        <!--Tab Bar Controller-->
        <scene sceneID="tab-bar-scene">
            <objects>
                <tabBarController storyboardIdentifier="mainTabBar" id="mainTabBar" sceneMemberID="viewController">
                    <tabBar key="tabBar" contentMode="scaleToFill" id="tabBar-id">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="49"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                    </tabBar>
                    <connections>
                        <segue destination="nav-dashboard" kind="relationship" relationship="viewControllers" id="seg-nav-dash"/>
                        <segue destination="nav-khosach" kind="relationship" relationship="viewControllers" id="seg-nav-sach"/>
                        <segue destination="nav-muontra" kind="relationship" relationship="viewControllers" id="seg-nav-muon"/>
                        <segue destination="nav-docgia" kind="relationship" relationship="viewControllers" id="seg-nav-dg"/>
                        <segue destination="nav-caidat" kind="relationship" relationship="viewControllers" id="seg-nav-cd"/>
                    </connections>
                </tabBarController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="tab-first-resp" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="-1000" y="0.0"/>
        </scene>

        <!--Tab 1: Navigation Trang Chu-->
        <scene sceneID="scene-nav-dash">
            <objects>
                <navigationController id="nav-dashboard" sceneMemberID="viewController">
