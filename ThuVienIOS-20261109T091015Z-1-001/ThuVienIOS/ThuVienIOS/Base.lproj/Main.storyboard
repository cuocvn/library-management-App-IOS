                        <autoresizingMask key="autoresizingMask"/>
                    </navigationBar>
                    <connections>
                        <segue destination="vc-dashboard" kind="relationship" relationship="rootViewController" id="seg-root-dash"/>
                    </connections>
                </navigationController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="resp-nav-dash" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="-300" y="-800"/>
        </scene>

        <!--Dashboard View Controller-->
        <scene sceneID="scene-vc-dash">
            <objects>
                <viewController storyboardIdentifier="DashboardVC" id="vc-dashboard" customClass="DashboardViewController" customModule="ThuVienIOS" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="view-dash">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <viewLayoutGuide key="safeArea" id="guide-dash"/>
